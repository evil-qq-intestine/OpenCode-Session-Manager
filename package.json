{
  "name": "opencode-ocsm",
  "version": "1.0.0",
  "description": "OCSM - OpenCode Session Manager. Select and manage sessions from any directory.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ocsm": "./dist/cli.js",
    "ocsm-setup": "./dist/setup.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js dist/setup.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "setup": "node dist/setup.js"
  },
  "keywords": [
    "opencode",
    "plugin",
    "session",
    "manager",
    "cli"
  ],
  "author": "evil-qq-intestine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evil-qq-intestine/OpenCode-Session-Manager"
  },
  "bugs": {
    "url": "https://github.com/evil-qq-intestine/OpenCode-Session-Manager/issues"
  },
  "homepage": "https://github.com/evil-qq-intestine/OpenCode-Session-Manager#readme",
  "license": "MIT",
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^12.11.1",
    "inquirer": "^9.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "locales",
    "README.md"
  ]
